{%- set e = seite.einstellungen -%}
{%- set basis = e.domain | replace(r/\/$/, "") -%}
{%- set buchen = e.buchung_url or ("mailto:" + e.email if e.email else "#termin") -%}
<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel or e.seitentitel }}</title>
<meta name="description" content="{{ e.beschreibung }}">
<link rel="canonical" href="{{ basis }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="de_CH">
<meta property="og:title" content="{{ titel or e.seitentitel }}">
<meta property="og:description" content="{{ e.beschreibung }}">
<meta property="og:url" content="{{ basis }}{{ page.url }}">
{% if seite.einstieg.bild %}<meta property="og:image" content="{{ basis }}{{ seite.einstieg.bild }}">{% endif %}
<link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
{% if page.url == "/" %}<script type="application/ld+json">{{ seite | jsonld | safe }}</script>{% endif %}
</head>
<body>
<a class="sprung" href="#inhalt">Zum Inhalt springen</a>
<header class="kopf rahmen">
  <a class="marke" href="/">{{ e.praxisname }}</a>
  <nav aria-label="Hauptnavigation">
    <a href="/#angebot">Angebot</a>
    <a href="/#konditionen">Konditionen</a>
    <a href="/#ueber-mich">Über mich</a>
    <a href="/#fragen">Fragen</a>
    <a class="knopf" href="/#termin">Termin buchen</a>
  </nav>
</header>
<main id="inhalt">
{{ content | safe }}
</main>
<footer class="fuss">
  <div class="rahmen fuss-reihe">
    <div>
      <p class="marke">{{ e.praxisname }}</p>
      <p>{{ e.person }}{% if e.ort %} · {{ e.ort }}{% endif %}
      {%- if e.email %}<br><a href="mailto:{{ e.email }}">{{ e.email }}</a>{% endif %}
      {%- if e.telefon %} · <a href="tel:{{ e.telefon | replace(' ', '') }}">{{ e.telefon }}</a>{% endif %}</p>
    </div>
    <nav aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/#termin">Termin buchen</a>
    </nav>
  </div>
  {% if seite.fusszeile.krisenhinweis %}<p class="rahmen klein">{{ seite.fusszeile.krisenhinweis }}</p>{% endif %}
</footer>
</body>
</html>
